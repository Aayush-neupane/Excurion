# ------------------------------------------------------------------
# Frontend-safe variables (inlined into the browser bundle by Vite).
# Required to enable the real Supabase backend. When unset, the app
# falls back to the built-in mock services and stays fully functional.
# ------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# tldraw license key (get a free trial/hobby key at tldraw.dev/get-a-license)
# Required only for production deployments; development works without it.
VITE_TLDRAW_LICENSE_KEY=

# ------------------------------------------------------------------
# Server-only variables (Netlify Functions). Never prefix with VITE_ —
# they must never reach the browser.
# ------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# Email delivery for OTP codes (optional; codes are returned in dev when unset)
RESEND_API_KEY=
RESEND_FROM=